<% content_for :title, "History: #{@asset.name} · Folklore" %>
<% owner = writable?(@asset) %>

<header class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <div class="min-w-0">
    <p class="truncate text-sm text-surface-700"><%= @asset.dir %></p>
    <h1 class="truncate text-2xl font-bold tracking-tight">History: <%= @asset.name %></h1>
  </div>
  <%= link_to asset_url_for(@asset), data: { testid: "back-to-asset" }, class: "inline-flex items-center gap-1 text-sm no-underline" do %>
    <%= heroicon_tag "arrow-left", variant: :outline, class: "h-4 w-4" %>
    <span>Back to file</span>
  <% end %>
</header>

<ol data-testid="version-list" class="flex flex-col gap-6">
  <% if @page == 1 %>
    <li data-testid="version-head" class="rounded-card border border-surface-300 bg-white p-4">
      <div class="mb-2 flex flex-wrap items-baseline gap-2 text-sm">
        <strong>Current</strong>
        <time class="text-surface-700" datetime="<%= @asset.updated_at.iso8601 %>"><%= @asset.updated_at.strftime("%Y-%m-%d %H:%M") %></time>
        <span class="text-surface-700">version <%= @asset.lock_version %></span>
      </div>
      <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words rounded-md bg-surface-50 p-3 font-mono text-xs"><code><%= @asset.content %></code></pre>
    </li>
  <% end %>

  <% @versions.each do |version| %>
    <li data-testid="version-<%= version.id %>" class="rounded-card border border-surface-300 bg-white p-4">
      <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
        <time datetime="<%= version.created_at.iso8601 %>"><%= version.created_at.strftime("%Y-%m-%d %H:%M") %></time>
        <% if version.actor_user %>
          <span data-testid="version-actor" class="text-surface-700"><%= [ version.actor_user.handle, version.actor_agent ].compact.join("/") %></span>
        <% end %>
        <% if owner %>
          <%= button_to "Restore this version", asset_version_restore_path(@asset, version), method: :post,
                form: { class: "ml-auto" }, data: { testid: "restore-version-#{version.id}" },
                class: "inline-flex h-9 items-center gap-1.5 rounded-button border-2 border-primary bg-transparent px-4 text-sm font-bold text-primary no-underline hover:bg-primary-soft cursor-pointer" %>
        <% end %>
      </div>
      <p class="mb-2 text-xs text-surface-700">Left: this version. Right: current.</p>
      <div data-testid="version-diff-<%= version.id %>">
        <%= render Versions::DiffComponent.new(old_content: version.content, new_content: @asset.content) %>
      </div>
    </li>
  <% end %>
</ol>

<% if @versions.empty? && @page == 1 %>
  <p data-testid="versions-empty" class="mt-6 text-sm text-surface-700">No earlier versions: this file has not been edited since it was created.</p>
<% elsif @versions.empty? %>
  <p data-testid="versions-page-empty" class="mt-6 text-sm text-surface-700">No versions on this page.</p>
<% end %>

<% if @page > 1 || @more %>
  <nav class="mt-6 flex items-center justify-between text-sm font-bold">
    <% if @page > 1 %>
      <%= link_to asset_url_for(@asset, action: :versions, page: (@page - 1 if @page > 2)), data: { testid: "versions-newer" },
            class: "inline-flex items-center gap-1 no-underline" do %>
        <%= heroicon_tag "arrow-up", variant: :outline, class: "h-4 w-4" %><span>Newer</span>
      <% end %>
    <% else %>
      <span></span>
    <% end %>
    <% if @more %>
      <%= link_to asset_url_for(@asset, action: :versions, page: @page + 1), data: { testid: "versions-older" },
            class: "inline-flex items-center gap-1 no-underline" do %>
        <span>Older</span><%= heroicon_tag "arrow-down", variant: :outline, class: "h-4 w-4" %>
      <% end %>
    <% end %>
  </nav>
<% end %>
