<% content_for :title, "New file · Folklore" %>

<h1 class="mb-6 text-2xl font-bold tracking-tight text-surface-900">New file</h1>

<% if @error.present? %>
  <p data-testid="error" class="mb-6 rounded-md border border-error-300 bg-error-50 px-4 py-3 text-sm text-error-900"><%= @error %></p>
<% end %>

<%= form_with url: files_path, data: { testid: "new-asset-form", turbo: false }, class: "flex max-w-4xl flex-col gap-4" do |f| %>
  <div class="flex flex-col gap-2">
    <%= f.label :path, "Folder (e.g. #{current_user.handle}/notes)", for: "asset_path", class: "text-sm font-bold text-surface-900" %>
    <%= f.text_field :path, name: "asset[path]", id: "asset_path", value: @path, required: true, class: "h-10 rounded-md border border-surface-300 bg-white px-3 text-base text-surface-900 placeholder:text-surface-500" %>
  </div>

  <%= render "assets/fields", f:, name: @name, content: @content, tags: @tags %>

  <div class="mt-2 flex items-center gap-2">
    <%= f.submit "Create", class: "inline-flex h-10 cursor-pointer items-center justify-center rounded-button border-2 border-primary bg-primary px-6 text-sm font-bold text-white no-underline hover:border-primary-hover hover:bg-primary-hover hover:text-white" %>
    <%= link_to "Cancel", workspace_path(handle: current_user.handle), class: "inline-flex h-10 items-center justify-center rounded-button border-2 border-primary bg-transparent px-6 text-sm font-bold text-primary no-underline hover:bg-primary-soft" %>
  </div>
<% end %>
