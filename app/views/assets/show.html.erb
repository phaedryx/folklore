<% content_for :title, "#{@asset.name} · Folklore" %>
<% handle, location = @asset.dir.split("/", 2) %>

<div class="mb-4 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <%= render Layout::BreadcrumbComponent.new(handle:, location: location || "") %>
    <% if location.nil? %>
      <%= link_to handle, workspace_path(handle:), class: "text-sm font-medium text-surface-700 no-underline hover:text-primary" %>
    <% end %>
    <h1 class="mt-1 truncate text-2xl font-bold tracking-tight text-surface-900"><%= @asset.name %></h1>
    <% if @asset.stale? %>
      <p data-testid="asset-stale" class="mt-1 text-sm font-medium text-warning-700">
        Review was due <%= @asset.stale_after.to_fs(:long) %>
      </p>
    <% end %>
  </div>

  <div data-testid="asset-actions" class="flex flex-wrap items-center gap-3 text-sm">
    <%= link_to asset_url_for(@asset, action: :raw), download: @asset.name, data: { testid: "asset-download" },
          class: "inline-flex items-center gap-1 no-underline" do %>
      <%= heroicon_tag "arrow-down-tray", variant: :outline, class: "h-4 w-4" %>Download
    <% end %>
    <%= link_to asset_url_for(@asset, action: :versions), data: { testid: "asset-history" },
          class: "inline-flex items-center gap-1 no-underline" do %>
      <%= heroicon_tag "clock", variant: :outline, class: "h-4 w-4" %>History
    <% end %>
    <% if writable?(@asset) %>
      <%= link_to asset_url_for(@asset, action: :edit), data: { testid: "asset-edit" },
            class: "inline-flex items-center gap-1 no-underline" do %>
        <%= heroicon_tag "pencil-square", variant: :outline, class: "h-4 w-4" %>Edit
      <% end %>
      <%# A stale asset needs a new review date or verifying leaves it due; offer one, pre-filled. %>
      <%= form_with url: verify_asset_path(@asset.slug), method: :post, class: "inline-flex items-center gap-2" do |f| %>
        <% if @asset.stale? %>
          <%= f.label :stale_after, "Next review", for: "asset_next_review", class: "text-xs text-surface-700" %>
          <%= f.date_field :stale_after, id: "asset_next_review", value: (Date.current + Review::StaleEntryComponent::DEFAULT_INTERVAL).iso8601,
                class: "rounded border border-surface-300 px-2 py-0.5 text-xs" %>
        <% end %>
        <%= button_tag type: "submit", name: nil, data: { testid: "asset-verify" }, title: "Mark as still true",
              class: "inline-flex cursor-pointer items-center gap-1 border-0 bg-transparent p-0 text-primary hover:text-primary-hover" do %>
          <%= heroicon_tag "check-badge", variant: :outline, class: "h-4 w-4" %>Verify
        <% end %>
      <% end %>
      <%= button_to asset_url_for(@asset), method: :delete, form: { class: "contents" },
            data: { testid: "asset-archive", turbo_confirm: "Archive #{@asset.name}?" },
            class: "inline-flex cursor-pointer items-center gap-1 border-0 bg-transparent p-0 text-primary hover:text-primary-hover" do %>
        <%= heroicon_tag "archive-box-arrow-down", variant: :outline, class: "h-4 w-4" %>Archive
      <% end %>
    <% end %>
  </div>
</div>

<% if @asset.content.present? %>
  <%= render Assets::ContentComponent.new(asset: @asset) %>
<% else %>
  <p data-testid="asset-empty" class="rounded-card border border-surface-200 bg-white px-4 py-6 text-center text-sm text-surface-700">This file is empty.</p>
<% end %>

<%= render Assets::BacklinksComponent.new(assets: @backlinks) %>
