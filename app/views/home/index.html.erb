<% content_for :title, "Folklore" %>

<div class="mx-auto flex w-full max-w-2xl flex-col gap-6">
  <h1 class="text-2xl font-bold tracking-tight">
    Signed in as <span data-testid="current-handle"><%= current_user.handle %></span>
  </h1>

  <p class="text-surface-700">
    Your agents reach this server through MCP at <code><%= request.base_url %>/mcp</code>
    with a bearer token from <%= link_to "Settings", settings_tokens_path, class: "font-bold" %>
    or the one <code>bin/setup</code> printed.
  </p>

  <p>
    <%= link_to "Browse your workspace", workspace_path(handle: current_user.handle),
          data: { testid: "home-workspace" },
          class: "inline-flex h-10 items-center rounded-button border-2 border-primary bg-primary px-6 text-sm font-bold text-white no-underline hover:border-primary-hover hover:bg-primary-hover hover:text-white" %>
  </p>
</div>
