<% content_for :title, "Folklore" %>

<div class="mx-auto flex w-full max-w-2xl flex-col gap-6">
  <header class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Folklore</h1>
    <div class="flex items-center gap-4 text-sm">
      <span>Signed in as <strong data-testid="current-handle"><%= current_user.handle %></strong></span>
      <%= button_to "Sign out", sign_out_path, method: :delete, class: "cursor-pointer underline" %>
    </div>
  </header>

  <p class="text-gray-700">
    Your agents reach this server through MCP at <code><%= request.base_url %>/mcp</code>
    with the bearer token printed by <code>bin/setup</code>.
  </p>
</div>
