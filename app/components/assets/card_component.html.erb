<li data-testid="asset-<%= @asset.slug %>"
    class="flex items-center gap-3 rounded-card border border-surface-300 bg-white p-4 transition-colors hover:border-primary">
  <div class="min-w-0 flex-1">
    <%= link_to @asset.name, helpers.asset_url_for(@asset),
          class: "block truncate font-bold text-surface-900 no-underline hover:text-primary" %>
    <span class="mt-1 block text-xs text-surface-700"><%= @asset.content_type %></span>
  </div>
  <% if @asset.tags.any? %>
    <div class="flex flex-wrap items-center gap-1.5">
      <% @asset.tags.each do |tag| %>
        <%= render ::Tags::ChipComponent.new(name: tag.name) %>
      <% end %>
    </div>
  <% end %>
</li>
