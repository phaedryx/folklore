<ul data-testid="task-list" class="space-y-2">
  <% @tasks.each do |task| %>
    <li data-testid="task-row-<%= task.slug %>"
        class="flex flex-wrap items-center justify-between gap-3 rounded-card border border-surface-300 bg-white p-4">
      <div class="min-w-0 flex-1">
        <%= link_to task.name, helpers.asset_url_for(task),
              class: "block truncate font-bold text-surface-900 no-underline hover:text-primary" %>
        <span class="mt-0.5 block truncate text-xs text-surface-700"><%= task.dir %></span>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-xs text-surface-700">
        <% if (holder = claimer(task)) %>
          <span data-testid="task-claimer" class="font-mono"><%= holder %></span>
          <span data-testid="task-lease"><%= lease_label(task) %> <%= lease_time(task) %></span>
        <% end %>
        <%= render ::Tasks::StatusPillComponent.new(status: task.task.status) %>
      </div>
    </li>
  <% end %>
</ul>
