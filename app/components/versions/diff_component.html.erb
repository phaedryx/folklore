<div data-testid="version-diff" class="grid grid-cols-2 gap-px overflow-hidden rounded-md border border-surface-200 bg-surface-200 font-mono text-xs">
  <div data-diff-side="old" class="min-w-0 bg-white">
    <% rows.each do |old_cell, _new_cell| %>
      <div class="<%= css_for(old_cell) %> whitespace-pre-wrap break-words px-2 py-0.5"><%= old_cell.text if old_cell.present? %></div>
    <% end %>
  </div>
  <div data-diff-side="new" class="min-w-0 bg-white">
    <% rows.each do |_old_cell, new_cell| %>
      <div class="<%= css_for(new_cell) %> whitespace-pre-wrap break-words px-2 py-0.5"><%= new_cell.text if new_cell.present? %></div>
    <% end %>
  </div>
</div>
