<div class="mb-6 flex flex-col gap-2">
  <% if @alert %>
    <p data-testid="flash-alert" role="alert"
       class="rounded-md border border-error-300 bg-error-50 px-4 py-3 text-sm text-error-900"><%= @alert %></p>
  <% end %>
  <% if @notice %>
    <p data-testid="flash-notice"
       class="rounded-md border border-success-300 bg-success-50 px-4 py-3 text-sm text-success-900"><%= @notice %></p>
  <% end %>
</div>
