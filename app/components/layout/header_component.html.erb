<header data-testid="workspace-header"
        class="mb-6 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-surface-200 pb-4">
  <h1 data-testid="workspace-handle"
      class="text-2xl font-bold tracking-tight text-surface-900">
    <%= @owner.handle %>
  </h1>
  <%= render Layout::BreadcrumbComponent.new(handle: @owner.handle, location: @location) %>
</header>
