# Copy to .env.development.local (never committed) or export in the shell.
# docs/configuration.md describes every variable the app reads.

# Production database connection URL. Development and test use
# config/database.yml (folklore_development / folklore_test).
DATABASE_URL=

# Single-user mode: bin/setup provisions this user and prints a first MCP
# token. Missing values are prompted for when stdin is a terminal.
FOLKLORE_ADMIN_HANDLE=
FOLKLORE_ADMIN_EMAIL=
FOLKLORE_ADMIN_PASSWORD=

# Development and test: suffix for the local database names (folklore_test_<suffix>).
FOLKLORE_DB_SUFFIX=

# The search log is on in development and production. In the test
# environment it is off unless this is 1.
FOLKLORE_SEARCH_LOG=

# The search-eval queries file, when not given as the rake argument
# (bin/rails "folklore:search_eval[path]"). Never committed.
FOLKLORE_EVAL_QUERIES=

# Production only: comma-separated host names the app answers to
# (DNS rebinding protection). Unset allows any host.
FOLKLORE_HOSTS=

# Port for bin/dev's web process (default 3000). Export it in the shell:
# bin/dev (foreman) does not read .env.development.local, though the
# .mcp.json snippet bin/setup prints does, so the two would disagree.
PORT=

# Production only: signs session cookies (generate with bin/rails secret),
# unless RAILS_MASTER_KEY unlocks your own config/credentials.yml.enc.
SECRET_KEY_BASE=
