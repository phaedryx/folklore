# Copy to .env.development.local (never committed) or export in the shell.

# Production database connection URL. Development and test use
# config/database.yml (folklore_development / folklore_test, suffixed with
# _$ATELIER_WORKSTREAM when that is set).
DATABASE_URL=

# Single-user mode: bin/setup provisions this user and prints a first MCP
# token. Missing values are prompted for when stdin is a terminal.
FOLKLORE_ADMIN_HANDLE=
FOLKLORE_ADMIN_EMAIL=
FOLKLORE_ADMIN_PASSWORD=

# Port for bin/dev's web process (default 3000).
PORT=
