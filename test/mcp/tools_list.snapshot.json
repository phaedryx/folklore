[
  {
    "name": "activity",
    "description": "Recent activity across the store, newest first (50 by default). Filter by actor (a handle, handle/agent, or email), tag, and since/before timestamps (ISO 8601 or a plain date and time). Pass since_id to read forward from a cursor instead: events after that id, oldest first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "since_id": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "created_at": {
                "type": "string"
              },
              "actor": {
                "type": [
                  "null",
                  "object"
                ],
                "properties": {
                  "handle": {
                    "type": "string"
                  },
                  "agent": {
                    "type": "string"
                  }
                },
                "required": []
              },
              "action": {
                "type": "string"
              },
              "slug": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "metadata": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "created_at",
              "actor",
              "action",
              "slug",
              "metadata"
            ]
          }
        }
      },
      "required": [
        "events"
      ]
    },
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "add_tag",
    "description": "Attach a tag to an asset by slug, creating the tag if needed. Names are lowercased. A tag already there is not an error: changed is false.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
