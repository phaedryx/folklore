        "slug": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "slug",
        "version"
      ]
    },
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "claim_task",
    "description": "Claim a task under a lease, as your agent. Pass a slug to claim that task, or omit it and pass path_prefix (and optionally tags) to claim the oldest pending task there. Atomic: only one claimer wins. A claim belongs to (you, agent): pass agent when several agents share one token, so they exclude each other. Claiming a task you already hold renews its lease; a task whose lease (lease_seconds, default 1800) has run out can be claimed by anyone. Finish it with complete_task or fail_task.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "path_prefix": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lease_seconds": {
          "type": "integer"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "claimed_by": {
          "type": "string"
        },
        "lease_until": {
          "type": "string"
        },
        "attempts": {
          "type": "integer"
        }
      },
      "required": [
        "slug",
        "location",
        "claimed_by",
        "lease_until",
        "attempts"
      ]
    },
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "complete_task",
    "description": "Mark a task you hold done, with an optional outcome note. Only the (you, agent) that claimed it can complete it; pass the same agent you claimed with. Anyone else gets Wrong claimer.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "note": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "slug",
        "status",
        "note"
      ]
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "create",
    "description": "Create an asset. 'path' is the directory, starting with your handle (a trailing filename is rejected); 'name' is the leaf (no '/' or whitespace, not '.' or '..'). Conflict if the name is taken there; update an existing asset by slug with update.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "name"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
