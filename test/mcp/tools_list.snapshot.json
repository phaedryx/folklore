    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "slug",
        "tag",
        "tags",
        "changed"
      ]
    },
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "add_task",
    "description": "Create a new task at the given path, status 'pending'. 'path' is the DIRECTORY only and must be under your own workspace; 'name' is the leaf. Tags pass through as given. Claim it with claim_task, finish it with complete_task or fail_task.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "name"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "location",
        "status"
      ]
    },
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "append",
    "description": "Append text to an existing asset by slug, on a new line. Snapshots prior content into versions. Not found if archived.",
